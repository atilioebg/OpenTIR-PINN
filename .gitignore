# =========================================================================
# OpenTIR-PINN Official Repository .gitignore
# Rules: Only essential production, evaluation, and documentation assets
# are pushed to remote. Heavy data, intermediate notes, and manuscript
# drafts remain local.
# =========================================================================

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.env
.venv
*.log
*.sqlite
*.db

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local Manuscript Drafts & Revisions (Local Only)
manuscript/
*.docx
*.pdf
*.pptx

# Zenodo Release Package & Large Archives (Local Only - Hosted on Zenodo)
zenodo_release/
*.zip
*.tar.gz
*.7z

# Intermediate Paper Logs & Experimental Workbenches (Local Only)
paper_log/
outputs/
outputs_dual/
logs/

# Restricted / Proprietary Radiative Transfer Configurations (Local Only)
modtran/

# Literature, PDFs & Reference Libraries (Local Only - Copyrighted)
bibliografic_references/

# Heavy / Intermediate Data Artifacts (Local Only - Raw & Binary Tensors)
data/raw/
data/processed/
data/archive/
data/validation/
data/smoke/
data/DATASET_AUDIT_LOG.md
data/validation_run.log

